              <SubComponents>
                <Component class="javax.swing.JTextArea" name="jTextArea1">
                  <Properties>
                    <Property name="columns" type="int" value="5"/>
                    <Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor">
                      <Font name="Lucida Sans" size="10" style="1"/>
                    </Property>
                    <Property name="rows" type="int" value="7"/>
                    <Property name="tabSize" type="int" value="10"/>
                    <Property name="text" type="java.lang.String" value="TAP Tech (PVT)Ltd focuses on highly qualitative, timely delivered and cost-effective offshore software solutions. &#xa;With a rich and varied experience in providing software development, project management capabilities and stringent &#xa;quality standards ensure to develop solutions that give your business an edge over your competitors. We are experts at&#xa;developing and implementing applications for mission-critical and enterprise-wide projects. Our dedicated team at &#xa;TAP Tech (PVT)Ltd strategically approaches your challenges to develop solutions and system administration services&#xa;that meet your objectives - both short and long term. We specialize in E- Business Solutions wherein we undertake&#xa;designing, development, maintenance and promotion of Web Sites coupled with any other Web Applications. With our &#xa;resource pool of experienced professionals coupled with state-of-the-art technology and industry best practices, it is&#xa;our vision to make our customers the best in the industry offering the best solutions."/>
                  </Properties>
                </Component>
              </SubComponents>
